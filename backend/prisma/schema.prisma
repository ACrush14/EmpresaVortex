generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  price       Float?
  isDonation  Boolean  @default(false)
  imageUrl    String
  contact     String
  ownerId     String
  createdAt   DateTime @default(now())
}
